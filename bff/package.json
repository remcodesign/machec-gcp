  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.30.2",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
